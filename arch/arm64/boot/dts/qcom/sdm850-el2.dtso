/*
 * sdm850 specific modifications required to boot in EL2.
 */

/dts-v1/;
/plugin/;

/* We can't and don't need to use zap shader in EL2 as linux can zap the gpu on its own. */
&gpu_zap_shader {
	status = "disabled";
};

/* Venus can be used in EL2 if booted similarly to ChromeOS devices. */
&venus {
	video-firmware {
		iommus = <&apps_smmu 0x10b2 0x0>;
	};
};

/*
 * TrustZone only accepts memory assignment requests from the hypervisor, i.e.,
 * QHEE, and requires the buffers they pass to reside in a shared memory bridge
 * for the hypervisor VM. With QHEE out of the picture, the SCM driver can issue
 * such requests itself, using a bridge that it registers for 64 KiB of QHEE's
 * (now unused) carveout. This is needed to start the modem, which also hosts
 * the WLAN firmware.
 */
&{/firmware/scm} {
	qcom,hyp-shm-bridge = <&hyp_mem 0x400000 0x10000>;
};

/*
 * In EL2, the ADSP, CDSP and SLPI cannot be started: TZ refuses to initialize
 * their firmware images, and even when the image metadata and the memory of
 * the DSP are passed via SHM bridges for the hypervisor VM, which makes TZ
 * authenticate and release them, they never signal that they are up.
 */
&adsp_pas {
	status = "disabled";
};

&cdsp_pas {
	status = "disabled";
};

&slpi_pas {
	status = "disabled";
};

/* The sound card depends on the audio services that run on the ADSP. */
&sound {
	status = "disabled";
};
